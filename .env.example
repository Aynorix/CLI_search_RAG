# Environment configuration for Assignment 3 - RAG System
# Copy this file to .env and configure your preferred provider.

# Option 1: OpenRouter (Default configured)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Option 2: OpenAI Direct
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Option 3: Groq (Free & Ultra-fast: https://console.groq.com)
# GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# Option 4: Google Gemini (Free: https://aistudio.google.com)
# GEMINI_API_KEY=AIza_your_gemini_key_here
# GEMINI_MODEL=gemini-1.5-flash

# Option 5: Local Ollama (No API key needed)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OLLAMA_MODEL=llama3
